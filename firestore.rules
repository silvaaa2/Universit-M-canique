rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function tokenValue(name, fallback) {
      return request.auth.token.get(name, fallback);
    }

    function hasEmailIdentity() {
      return isSignedIn() && tokenValue("email", "") != "";
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(tokenValue("email", ""))).data;
    }

    function userRole() {
      return userData().role;
    }

    function isDiscordProf() {
      return isSignedIn()
        && tokenValue("authProvider", "") == "discord"
        && tokenValue("role", "") == "prof";
    }

    function isDiscordAdmin() {
      return isDiscordProf() && tokenValue("admin", false) == true;
    }

    function isProf() {
      return isDiscordProf() || (hasEmailIdentity() && userRole() == "prof");
    }

    function isStage() {
      return hasEmailIdentity() && userRole() == "stage";
    }

    function isAdmin() {
      return isDiscordAdmin() || (hasEmailIdentity() && userData().admin == true);
    }

    function isOwner() {
      return isDiscordAdmin() && tokenValue("owner", false) == true;
    }

    function hasSitePermission(permission) {
      return isAdmin()
        || !isDiscordProf()
        || !request.auth.token.keys().hasAny(["sitePermissions"])
        || tokenValue("sitePermissions", []).hasAny([permission]);
    }

    match /users/{userEmail} {
      allow read: if isSignedIn() && (tokenValue("email", "") == userEmail || isAdmin());
      allow write: if isOwner();
    }

    match /studentAnswerStatuses/{docId} {
      allow read, write: if (isProf() || isAdmin()) && hasSitePermission("customResponses");
    }

    match /studentModules/{docId} {
      allow read, write: if (isProf() || isAdmin()) && hasSitePermission("modules");
    }

    match /studentModuleArchives/{docId} {
      allow read: if (isProf() || isAdmin()) && hasSitePermission("modules");
      allow write: if isAdmin();
    }

    match /examAnswerStatuses/{docId} {
      allow read: if isStage() || isAdmin() || (isProf() && hasSitePermission("exams"));
      allow write: if isAdmin() || (isProf() && hasSitePermission("exams"));
    }

    match /examCorrections/{docId} {
      allow read, write: if isAdmin() || (isProf() && hasSitePermission("exams"));
    }

    match /customAnswerKeys/{docId} {
      allow read: if isAdmin() || (isProf() && hasSitePermission("corrections"));
      allow write: if isAdmin();
    }

    match /customPages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customAvailability/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (isProf() && hasSitePermission("customAccess"));
    }

    match /profSettings/{docId} {
      allow read: if isAdmin()
        || (isProf() && !(docId in ["profAccessControl", "auditLogSettings"]));
      allow write: if isAdmin()
        && !(docId in ["profAccessControl", "auditLogSettings"]);
    }

    match /stageValidations/{docId} {
      allow read, write: if isStage() || isAdmin() || (isProf() && hasSitePermission("stages"));
    }

    match /stageArchives/{docId} {
      allow read: if isStage() || isAdmin() || (isProf() && hasSitePermission("stages"));
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title", "startDate", "endDate", "startDisplay", "endDisplay",
          "datesUpdatedAt", "datesUpdatedBy"
        ]);
    }

    match /stageHistory/{docId} {
      allow read: if isAdmin()
        || (resource.data.get("recordType", "") != "auditLog" && (isStage() || (isProf() && hasSitePermission("stages"))));
      allow create: if request.resource.data.get("recordType", "") != "auditLog"
        && (isProf() || isStage() || isAdmin());
      allow update, delete: if false;
    }

    match /stageSettings/{docId} {
      allow read: if docId in ["effectif", "moduleEffectif"];
      allow write: if docId in ["effectif", "moduleEffectif"] && isAdmin();
    }

    match /stageComments/{docId} {
      allow read: if isProf() || isStage() || isAdmin();
      allow create, update: if isProf() || isStage() || isAdmin();
      allow delete: if false;
    }
  }
}
