{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/secure-exam-loader.js": {
      "includeFiles": "assets/js/exam-loader-x8p2.js"
    },
    "api/secure-rp-loader.js": {
      "includeFiles": "assets/js/rp-loader-9kq4z.js"
    }
  },
  "redirects": [
    {
      "source": "/pages/espace-prof-v2.html",
      "destination": "/pages/espace-prof.html",
      "permanent": true
    },
    {
      "source": "/assets/js/exam-loader-x8p2.js",
      "destination": "/assets/js/secure-exam-loader.js",
      "permanent": false
    },
    {
      "source": "/assets/js/rp-loader-9kq4z.js",
      "destination": "/assets/js/secure-rp-loader.js",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/js/secure-exam-loader.js",
      "destination": "/api/secure-exam-loader"
    },
    {
      "source": "/assets/js/secure-rp-loader.js",
      "destination": "/api/secure-rp-loader"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/pages/espace-prof.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/Images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=7776000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
