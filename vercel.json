{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/secure-exam-loader.js": {
      "includeFiles": "assets/js/exam-loader-x8p2.js"
    },
    "api/secure-rp-loader.js": {
      "includeFiles": "assets/js/rp-loader-9kq4z.js"
    }
  },
  "redirects": [
    {
      "source": "/pages/espace-prof-v2.html",
      "destination": "/pages/espace-prof.html",
      "permanent": true
    },
    {
      "source": "/assets/js/exam-loader-x8p2.js",
      "destination": "/assets/js/secure-exam-loader.js",
      "permanent": false
    },
    {
      "source": "/assets/js/rp-loader-9kq4z.js",
      "destination": "/assets/js/secure-rp-loader.js",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/js/secure-exam-loader.js",
      "destination": "/api/secure-exam-loader"
    },
    {
      "source": "/assets/js/secure-rp-loader.js",
      "destination": "/api/secure-rp-loader"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://accounts.google.com https://docs.google.com https://discord.com; frame-src https://accounts.google.com https://docs.google.com; form-action 'self' https://docs.google.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
