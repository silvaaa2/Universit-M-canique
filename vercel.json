{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/secure-exam-loader.js": {
      "includeFiles": "assets/js/exam-loader-x8p2.js"
    },
    "api/secure-rp-loader.js": {
      "includeFiles": "assets/js/rp-loader-9kq4z.js"
    },
    "api/secure-prof-auth-v2.js": {
      "includeFiles": "assets/js/prof-auth-v2.js"
    }
  },
  "redirects": [
    {
      "source": "/assets/js/exam-loader-x8p2.js",
      "destination": "/assets/js/secure-exam-loader.js",
      "permanent": false
    },
    {
      "source": "/assets/js/rp-loader-9kq4z.js",
      "destination": "/assets/js/secure-rp-loader.js",
      "permanent": false
    },
    {
      "source": "/assets/js/prof-auth-v2.js",
      "destination": "/assets/js/secure-prof-auth-v2.js",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/js/secure-exam-loader.js",
      "destination": "/api/secure-exam-loader"
    },
    {
      "source": "/assets/js/secure-rp-loader.js",
      "destination": "/api/secure-rp-loader"
    },
    {
      "source": "/assets/js/secure-prof-auth-v2.js",
      "destination": "/api/secure-prof-auth-v2"
    }
  ]
}
